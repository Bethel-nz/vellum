{
  "name": "vellum",
  "productName": "Vellum",
  "version": "1.0.0",
  "identifier": "dev.vellum.app",
  "description": "A markdown note you can talk to",
  "binariesDir": "dist",
  "outDir": "dist/bundle",
  "binaries": [{ "path": "Vellum", "main": true }],
  "resources": [{ "src": "dist/helpers/*.*", "target": "helpers" }, { "src": "dist/helpers/agent-browser-skills", "target": "helpers/agent-browser-skills" }],
  "formats": ["nsis"],
  "nsis": { "installMode": "currentUser" }
}
