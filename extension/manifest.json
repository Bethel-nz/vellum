{
  "manifest_version": 3,
  "name": "Vellum Snapshot",
  "version": "1.0.0",
  "description": "Select a page, leave a note, and send it to Vellum.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Vellum Snapshot \u2014 annotate this page"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-select": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Select elements to send to Vellum"
    }
  }
}
